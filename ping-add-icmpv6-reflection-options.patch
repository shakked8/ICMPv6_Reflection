+		struct icmp_ext_obj_hdr_wire *obj_hdr;
+		uint8_t *payload;
+		uint16_t reflect_seq = seq & 0xff;
+		uint16_t payload_len = rts->reflect_payload_len >= 0 ?
+					       rts->reflect_payload_len : rts->datalen;
