 	return finish(rts);
 }
 
+static void print_reflection_hex(const uint8_t *data, size_t len)
+{
+	size_t i;
+	size_t j;
+
+	for (i = 0; i < len; i += 16) {
+		printf("    0x%04zX:  ", i);
+
+		for (j = 0; j < 16; j++) {
+			if (i + j < len)
+				printf("%02X ", data[i + j]);
+			else
+				printf("   ");
+		}
+
+		printf(" |");
+		for (j = 0; j < 16; j++) {
+			if (i + j < len) {
+				unsigned char c = data[i + j];
+
+				printf("%c", (c >= 32 && c <= 126) ? c : '.');
+			} else {
+				printf(" ");
+			}
+		}
+		printf("|\n");
+	}
+}
+
+static void print_reflection_payload(uint8_t *ptr, int cc, int icmplen)
+{
+	struct icmp_ext_hdr_wire *ext_hdr;
+	struct icmp_ext_obj_hdr_wire *obj_hdr;
+	uint8_t *payload;
+	int remaining;
+	int obj_len;
+	int payload_len;
+	int min_len = icmplen + sizeof(*ext_hdr) + sizeof(*obj_hdr);
+
+	if (cc < min_len) {
+		printf("\n--- Reflect All Object Hex Dump unavailable ---\n");
+		return;
+	}
+
+	ext_hdr = (struct icmp_ext_hdr_wire *)ptr;
+	obj_hdr = (struct icmp_ext_obj_hdr_wire *)(ext_hdr + 1);
+	obj_len = ntohs(obj_hdr->length);
+	remaining = cc - icmplen - sizeof(*ext_hdr);
+
+	if (obj_len < (int)sizeof(*obj_hdr) || obj_len > remaining) {
+		printf("\n--- Reflect All Object Hex Dump malformed ---\n");
+		return;
+	}
+
+	payload = (uint8_t *)(obj_hdr + 1);
+	payload_len = obj_len - sizeof(*obj_hdr);
+
+	printf("\n--- Reflect All Object Hex Dump (%d bytes) ---\n", payload_len);
+	print_reflection_hex(payload, payload_len);
+}
+
 int gather_statistics(struct ping_rts *rts, uint8_t *icmph, int icmplen,
 		      int cc, uint16_t seq, int hops,
 		      int csfailed, struct timeval *tv, char *from,
@@ -760,9 +825,14 @@ int gather_statistics(struct ping_rts *rts, uint8_t *icmph, int icmplen,
 	if (!csfailed)
 		acknowledge(rts, seq);
 
-	if (rts->timing && cc >= (int)(8 + sizeof(struct timeval))) {
+	if (rts->timing &&
+	    (rts->opt_reflect || cc >= (int)(8 + sizeof(struct timeval)))) {
 		struct timeval tmp_tv;
-		memcpy(&tmp_tv, ptr, sizeof(tmp_tv));
+
+		if (rts->opt_reflect)
+			tmp_tv = rts->reflect_send_times[seq];
+		else
+			memcpy(&tmp_tv, ptr, sizeof(tmp_tv));
 
 restamp:
 		tvsub(tv, &tmp_tv);
@@ -847,7 +917,7 @@ restamp:
 		if (hops >= 0)
 			ping_print_int(rts, _(" ttl=%d"), "ttl", hops);
 
-		if (cc < rts->datalen + 8) {
+		if (!rts->opt_reflect && cc < rts->datalen + 8) {
 			ping_print_truncated(rts);
 			return 1;
 		}
@@ -887,20 +957,24 @@ restamp:
 		if (wrong_source)
 			printf(_(" (DIFFERENT ADDRESS!)"));
 
-		/* check the data */
-		cp = ((unsigned char *)ptr) + sizeof(struct timeval);
-		dp = &rts->outpack[8 + sizeof(struct timeval)];
-		for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp, ++dp) {
-			if (*cp != *dp) {
-				printf(_("\nwrong data byte #%d should be 0x%x but was 0x%x"),
-				       i, *dp, *cp);
-				cp = (unsigned char *)ptr + sizeof(struct timeval);
-				for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp) {
-					if ((i % 32) == sizeof(struct timeval))
-						printf("\n#%d\t", i);
-					printf("%x ", *cp);
+		if (rts->opt_reflect && rts->opt_hexdump) {
+			print_reflection_payload(ptr, cc, icmplen);
+		} else if (!rts->opt_reflect) {
+			/* check the data */
+			cp = ((unsigned char *)ptr) + sizeof(struct timeval);
+			dp = &rts->outpack[8 + sizeof(struct timeval)];
+			for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp, ++dp) {
+				if (*cp != *dp) {
+					printf(_("\nwrong data byte #%d should be 0x%x but was 0x%x"),
+					       i, *dp, *cp);
+					cp = (unsigned char *)ptr + sizeof(struct timeval);
+					for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp) {
+						if ((i % 32) == sizeof(struct timeval))
+							printf("\n#%d\t", i);
+						printf("%x ", *cp);
+					}
+					break;
 				}
-				break;
 			}
 		}
 	}
diff --git a/ping/rfc4884_reflection.h b/ping/rfc4884_reflection.h
new file mode 100644
index 0000000..7fc4b5c
--- /dev/null
+++ b/ping/rfc4884_reflection.h
@@ -0,0 +1,31 @@
+#ifndef IPUTILS_RFC4884_REFLECTION_H
+#define IPUTILS_RFC4884_REFLECTION_H
+
+#include <stdint.h>
+
+#ifndef ICMPV6_EXT_ECHO_REQUEST
+#define ICMPV6_EXT_ECHO_REQUEST 160
+#endif
+
+#ifndef ICMPV6_EXT_ECHO_REPLY
+#define ICMPV6_EXT_ECHO_REPLY 161
+#endif
+
+#define ICMP_EXT_HDR_VERSION			2
+#define ICMP_EXT_OBJ_CLASS_REFLECT_ALL		6
+#define ICMP_EXT_OBJ_CTYPE_REQUEST		0
+#define ICMP_EXT_OBJ_CTYPE_REPLY_NO_ERROR	1
+#define ICMP_EXT_OBJ_CTYPE_REPLY_UNSUPPORTED	2
+
+struct icmp_ext_hdr_wire {
+	uint16_t version_reserved;
+	uint16_t checksum;
+};
+
+struct icmp_ext_obj_hdr_wire {
+	uint16_t length;
+	uint8_t class_num;
+	uint8_t c_type;
+};
+
+#endif
