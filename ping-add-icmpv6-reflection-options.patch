 		else
 			ICMP6_FILTER_SETPASS(ICMP6_ECHO_REPLY, &filter);
 
@@ -581,17 +586,69 @@ out:
  * of the data portion are used to hold a UNIX "timeval" struct in VAX
  * byte-order, to compute the round-trip time.
  */
+static uint16_t rfc4884_checksum(const void *buf, size_t len)
+{
+	const uint16_t *words = buf;
+	uint32_t sum = 0;
+
+	while (len > 1) {
+		sum += *words++;
+		len -= 2;
+	}
+
+	if (len)
+		sum += *(const uint8_t *)words;
+
+	sum = (sum >> 16) + (sum & 0xffff);
+	sum += sum >> 16;
+
+	return ~sum;
+}
+
 int build_echo(struct ping_rts *rts, uint8_t *_icmph,
 	       unsigned packet_size __attribute__((__unused__)))
 {
-	struct icmp6_hdr *icmph;
+	struct icmp6_hdr *icmph = (struct icmp6_hdr *)_icmph;
+	uint16_t seq = (rts->ntransmitted + 1) & 0xffff;
 	int cc;
 
-	icmph = (struct icmp6_hdr *)_icmph;
+	if (rts->opt_reflect) {
+		struct icmp_ext_hdr_wire *ext_hdr;
+		struct icmp_ext_obj_hdr_wire *obj_hdr;
+		uint8_t *payload;
+		uint16_t payload_len = rts->datalen;
+		uint16_t obj_len = sizeof(*obj_hdr) + payload_len;
+		uint16_t ext_len = sizeof(*ext_hdr) + obj_len;
+
+		icmph->icmp6_type = ICMPV6_EXT_ECHO_REQUEST;
+		icmph->icmp6_code = 0;
+		icmph->icmp6_cksum = 0;
+		icmph->icmp6_seq = htons(seq);
+		icmph->icmp6_id = rts->ident;
+
+		ext_hdr = (struct icmp_ext_hdr_wire *)(_icmph + sizeof(*icmph));
+		obj_hdr = (struct icmp_ext_obj_hdr_wire *)(ext_hdr + 1);
+		payload = (uint8_t *)(obj_hdr + 1);
+
+		ext_hdr->version_reserved = htons(ICMP_EXT_HDR_VERSION << 12);
+		ext_hdr->checksum = 0;
+
+		obj_hdr->length = htons(obj_len);
+		obj_hdr->class_num = ICMP_EXT_OBJ_CLASS_REFLECT_ALL;
+		obj_hdr->c_type = ICMP_EXT_OBJ_CTYPE_REQUEST;
+
+		memset(payload, 0, payload_len);
+
+		ext_hdr->checksum = rfc4884_checksum(ext_hdr, ext_len);
+		gettimeofday(&rts->reflect_send_times[seq], NULL);
+
+		return sizeof(*icmph) + ext_len;
+	}
+
 	icmph->icmp6_type = ICMP6_ECHO_REQUEST;
 	icmph->icmp6_code = 0;
 	icmph->icmp6_cksum = 0;
-	icmph->icmp6_seq = htons(rts->ntransmitted + 1);
+	icmph->icmp6_seq = htons(seq);
 	icmph->icmp6_id = rts->ident;
 
 	if (rts->timing)
@@ -849,7 +906,8 @@ int ping6_parse_reply(struct ping_rts *rts, socket_st *sock,
 		return 1;
 	}
 
-	if (icmph->icmp6_type == ICMP6_ECHO_REPLY) {
+	if (icmph->icmp6_type == ICMP6_ECHO_REPLY ||
+	    icmph->icmp6_type == ICMPV6_EXT_ECHO_REPLY) {
 		if (!is_ours(rts, sock, icmph->icmp6_id))
 			return 1;
 
