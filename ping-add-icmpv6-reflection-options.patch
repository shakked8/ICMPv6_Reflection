@@ -666,8 +711,14 @@ int ping6_send_probe(struct ping_rts *rts, socket_st *sock, void *packet, unsign
 void pr_echo_reply(struct ping_rts *rts, uint8_t *_icmph, int cc __attribute__((__unused__)))
 {
