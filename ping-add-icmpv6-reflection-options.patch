+static int ping6_reflection_ext_csum_failed(struct ping_rts *rts,
+					     struct icmp6_hdr *icmph, int cc)
+{
+	struct icmp_ext_hdr_wire *ext_hdr;
+	struct icmp_ext_obj_hdr_wire *obj_hdr;
+	int obj_len;
+	int remaining;
+
+	if (cc < (int)(sizeof(*icmph) + sizeof(*ext_hdr) + sizeof(*obj_hdr))) {
+		if (rts->opt_verbose)
+			ping_error(rts, 0, 0, _("reflection reply too short: %d bytes"), cc);
+		return 1;
+	}
+
+	ext_hdr = (struct icmp_ext_hdr_wire *)((uint8_t *)icmph + sizeof(*icmph));
+	obj_hdr = (struct icmp_ext_obj_hdr_wire *)(ext_hdr + 1);
+	obj_len = ntohs(obj_hdr->length);
+	remaining = cc - sizeof(*icmph) - sizeof(*ext_hdr);
+
+	if (obj_len < (int)sizeof(*obj_hdr) || obj_len > remaining) {
+		if (rts->opt_verbose)
+			ping_error(rts, 0, 0, _("malformed Reflect All object length: %d"), obj_len);
+		return 1;
+	}
+
+	if (!rfc4884_checksum_valid(ext_hdr, sizeof(*ext_hdr) + obj_len)) {
+		if (rts->opt_verbose)
+			ping_error(rts, 0, 0, _("bad ICMP extension checksum"));
+		return 1;
+	}
+
+	return 0;
+}
+
