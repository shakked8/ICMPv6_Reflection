+
+		if (rts->opt_reflect)
+			tmp_tv = rts->reflect_send_times[seq];
+		else
+			memcpy(&tmp_tv, ptr, sizeof(tmp_tv));
 
 restamp:
 		tvsub(tv, &tmp_tv);
@@ -847,7 +923,7 @@ restamp:
 		if (hops >= 0)
