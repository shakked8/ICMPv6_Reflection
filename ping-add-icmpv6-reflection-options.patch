+static void print_reflection_hex(const uint8_t *data, size_t len)
+{
+	size_t i;
+	size_t j;
+
+	for (i = 0; i < len; i += 16) {
+		printf("    0x%04zX:  ", i);
+
+		for (j = 0; j < 16; j++) {
+			if (i + j < len)
+				printf("%02X ", data[i + j]);
+			else
+				printf("   ");
+		}
+
+		printf(" |");
+		for (j = 0; j < 16; j++) {
+			if (i + j < len) {
+				unsigned char c = data[i + j];
+
+				printf("%c", (c >= 32 && c <= 126) ? c : '.');
+			} else {
+				printf(" ");
+			}
+		}
+		printf("|\n");
+	}
+}
+
+static void print_reflection_payload(uint8_t *ptr, int cc, int icmplen)
+{
+	struct icmp_ext_hdr_wire *ext_hdr;
+	struct icmp_ext_obj_hdr_wire *obj_hdr;
+	uint8_t *payload;
+	int remaining;
+	int obj_len;
+	int payload_len;
+	int min_len = icmplen + sizeof(*ext_hdr) + sizeof(*obj_hdr);
+
+	if (cc < min_len) {
+		printf("\n--- Reflect All Object Hex Dump unavailable ---\n");
+		return;
+	}
+
+	ext_hdr = (struct icmp_ext_hdr_wire *)ptr;
+	obj_hdr = (struct icmp_ext_obj_hdr_wire *)(ext_hdr + 1);
+	obj_len = ntohs(obj_hdr->length);
+	remaining = cc - icmplen - sizeof(*ext_hdr);
+
+	if (obj_len < (int)sizeof(*obj_hdr) || obj_len > remaining) {
+		printf("\n--- Reflect All Object Hex Dump malformed ---\n");
+		return;
+	}
+
+	if (!rfc4884_checksum_valid(ext_hdr, sizeof(*ext_hdr) + obj_len)) {
+		printf("\n--- Reflect All Object Hex Dump has bad extension checksum ---\n");
+		return;
+	}
+
+	payload = (uint8_t *)(obj_hdr + 1);
+	payload_len = obj_len - sizeof(*obj_hdr);
+
+	printf("\n--- Reflect All Object Hex Dump (%d bytes) ---\n", payload_len);
+	print_reflection_hex(payload, payload_len);
+}
+
 int gather_statistics(struct ping_rts *rts, uint8_t *icmph, int icmplen,
 		      int cc, uint16_t seq, int hops,
