 			return 1;
 		}
@@ -887,20 +963,24 @@ restamp:
 		if (wrong_source)
 			printf(_(" (DIFFERENT ADDRESS!)"));
 
-		/* check the data */
-		cp = ((unsigned char *)ptr) + sizeof(struct timeval);
-		dp = &rts->outpack[8 + sizeof(struct timeval)];
-		for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp, ++dp) {
-			if (*cp != *dp) {
-				printf(_("\nwrong data byte #%d should be 0x%x but was 0x%x"),
-				       i, *dp, *cp);
-				cp = (unsigned char *)ptr + sizeof(struct timeval);
-				for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp) {
-					if ((i % 32) == sizeof(struct timeval))
-						printf("\n#%d\t", i);
-					printf("%x ", *cp);
+		if (rts->opt_reflect && rts->opt_hexdump) {
+			print_reflection_payload(ptr, cc, icmplen);
+		} else if (!rts->opt_reflect) {
+			/* check the data */
+			cp = ((unsigned char *)ptr) + sizeof(struct timeval);
+			dp = &rts->outpack[8 + sizeof(struct timeval)];
+			for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp, ++dp) {
+				if (*cp != *dp) {
+					printf(_("\nwrong data byte #%d should be 0x%x but was 0x%x"),
+					       i, *dp, *cp);
+					cp = (unsigned char *)ptr + sizeof(struct timeval);
+					for (i = sizeof(struct timeval); i < rts->datalen; ++i, ++cp) {
+						if ((i % 32) == sizeof(struct timeval))
+							printf("\n#%d\t", i);
+						printf("%x ", *cp);
+					}
+					break;
 				}
-				break;
 			}
 		}
 	}
diff --git a/ping/rfc4884_reflection.h b/ping/rfc4884_reflection.h
new file mode 100644
index 0000000..a7a391b
--- /dev/null
+++ b/ping/rfc4884_reflection.h
@@ -0,0 +1,65 @@
+#ifndef IPUTILS_RFC4884_REFLECTION_H
+#define IPUTILS_RFC4884_REFLECTION_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef ICMPV6_EXT_ECHO_REQUEST
+#define ICMPV6_EXT_ECHO_REQUEST 160
+#endif
+
+#ifndef ICMPV6_EXT_ECHO_REPLY
+#define ICMPV6_EXT_ECHO_REPLY 161
+#endif
+
+#define ICMP_EXT_HDR_VERSION			2
+#define ICMP_EXT_OBJ_CLASS_REFLECT_ALL		6
+#define ICMP_EXT_OBJ_CTYPE_REQUEST		0
+#define ICMP_EXT_OBJ_CTYPE_REPLY_NO_ERROR	1
+#define ICMP_EXT_OBJ_CTYPE_REPLY_UNSUPPORTED	2
+
+#define ICMPV6_EXT_ECHO_REQUEST_L		0x01
+
+/*
+ * Keep the IPv6 packet within the IPv6 minimum MTU:
+ * IPv6 header 40 + ICMPv6 header 8 + ICMP extension header 4 +
+ * Reflect All object header 4 + payload <= 1280.
+ */
+#define ICMPV6_REFLECT_MAX_PAYLOAD_LEN		1224
+
+struct icmp_ext_hdr_wire {
+	uint16_t version_reserved;
+	uint16_t checksum;
+};
+
+struct icmp_ext_obj_hdr_wire {
+	uint16_t length;
+	uint8_t class_num;
+	uint8_t c_type;
+};
+
+static inline uint16_t rfc4884_checksum(const void *buf, size_t len)
+{
+	const uint16_t *words = buf;
+	uint32_t sum = 0;
+
+	while (len > 1) {
+		sum += *words++;
+		len -= 2;
+	}
+
+	if (len)
+		sum += *(const uint8_t *)words;
+
+	sum = (sum >> 16) + (sum & 0xffff);
+	sum += sum >> 16;
+
+	return ~sum;
+}
+
+static inline int rfc4884_checksum_valid(const void *buf, size_t len)
+{
+	return rfc4884_checksum(buf, len) == 0;
+}
+
+#endif
