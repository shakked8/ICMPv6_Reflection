+	ping_print_uint(rts, _(" icmp_seq=%u"), "seq", seq);
 }
 
 static void putchar_safe(char c)
@@ -807,6 +858,40 @@ void pr_niquery_reply(struct ping_rts *rts, uint8_t *_nih, int len)
 	printf(_("; seq=%u;"), ntohsp((uint16_t *)nih->ni_nonce));
