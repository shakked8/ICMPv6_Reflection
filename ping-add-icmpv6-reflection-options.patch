 ping/ping.h               |   7 ++-
 ping/ping6_common.c       | 112 +++++++++++++++++++++++++++++++++++---
 ping/ping_common.c        | 112 ++++++++++++++++++++++++++++++++------
 ping/rfc4884_reflection.h |  65 ++++++++++++++++++++++
 5 files changed, 289 insertions(+), 27 deletions(-)
 create mode 100644 ping/rfc4884_reflection.h

